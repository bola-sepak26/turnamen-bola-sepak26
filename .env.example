# ===== Server =====
PORT=3000

# ===== Supabase Database (WAJIB) =====
# Supabase Dashboard > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
# Ganti [PASSWORD] dengan password database Anda.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ===== Supabase Storage (WAJIB untuk upload dokumen) =====
# Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project.supabase.co"
# Publishable/anon key: boleh dikirim ke browser (dipakai untuk upload langsung ke Storage)
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Secret/service_role key: RAHASIA, hanya di server. JANGAN pernah masuk ke kode klien atau Git.
SUPABASE_SECRET_KEY="your-secret-key"
